# Required production identity and routing
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
DATABASE_URL=postgresql://user:password@host:5432/database
ALLOWED_HOSTS=your-app.example.com
CSRF_TRUSTED_ORIGINS=https://your-app.example.com
APP_BASE_URL=https://your-app.example.com
APP_RELEASE=replace-with-deployed-git-sha

# Internal Superuser-only Design Lab. Does not migrate any operational UI.
UI_DESIGN_LAB_ENABLED=False

# P1a staff-browser authentication foundation: keep OFF; login/enrollment and
# operational browser routes are not mounted yet. Telegram access is unchanged.
STAFF_BROWSER_AUTH_ENABLED=False
# Browser-on uses the checked-in PostgreSQL security-state adapter (ADR 0074).
# Apply normal checked-in migrations first; no Redis/Memcached subscription.
STAFF_BROWSER_COMPLAINTS_ENABLED=False
# Synthetic review only; production rejects True. Never switches real data to fixtures.
STAFF_BROWSER_DEMO_ENABLED=False
# Dedicated Fernet keys in the deployment secret store, newest first. Never use
# DJANGO_SECRET_KEY here. Retain old decrypt keys while old MFA material exists.
STAFF_MFA_ENCRYPTION_KEYS=
STAFF_BROWSER_SESSION_AGE_SECONDS=28800

# Scheduled Portal email reports (Render environment secret store; no Gmail dependency)
REPORT_EMAIL_DELIVERY_ENABLED=False
RESEND_API_KEY=
# Sender address must belong to the verified Resend domain. Display name is optional;
# bare addresses are displayed as JBL BOT by the report renderer.
REPORT_EMAIL_FROM=JBL BOT <reports@example.com>
REPORT_EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Independent Loan Origination Mini App authentication
ORIGINATION_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
ORIGINATION_WEBAPP_AUTH_MAX_AGE_SECONDS=86400

# Optional Applicant phone/ID IT pilot. Disabled by default; no real calls in CI.
# Use the deployment secret store. Sandbox must contain synthetic test data only.
ORIGINATION_PHONE_ID_CHECK_ENABLED=False
ORIGINATION_PHONE_ID_CHECK_DAILY_LIMIT=50
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
# Separate stable random secret, at least 32 characters; rotation invalidates reuse.
DARAJA_PHONE_ID_HMAC_KEY=

# Origination SMS: applies to NEW signing links only; existing links retain their provider.
# Keep credentials in the deployment secret store. Default remains Africa's Talking.
ORIGINATION_SMS_PROVIDER=africas_talking
ORIGINATION_ADVANTA_PARTNER_ID=
ORIGINATION_ADVANTA_API_KEY=
ORIGINATION_ADVANTA_SENDER_ID=

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_DISPLAY_NAME=JBL Workflow Bot
STAFF_ACTIVATION_MINI_APP_SHORT_NAME=staff-activation
COMPLAINT_CASES_MINI_APP_SHORT_NAME=complaints
# Optional complaint-type suggestion service. For Google AI, supply its API
# base URL; the app resolves it to Gemini's native generateContent route.
# Keep the key server-side; start with shadow mode.
COMPLAINT_CATEGORY_AI_MODE=shadow
COMPLAINT_CATEGORY_AI_API_URL=https://generativelanguage.googleapis.com/v1beta
COMPLAINT_CATEGORY_AI_API_KEY=
COMPLAINT_CATEGORY_AI_MODEL=gemini-3.5-flash-lite
COMPLAINT_CATEGORY_AI_TIMEOUT_SECONDS=15
COMPLAINT_CATEGORY_AI_MAX_TOKENS=220
COMPLAINT_CATEGORY_AI_PROMPT_VERSION=v1
COMPLAINT_CATEGORY_AI_TOKEN_MAX_AGE_SECONDS=7200
TAT_TRACKER_MINI_APP_SHORT_NAME=tat
SPIN_MINI_APP_SHORT_NAME=spin
PORTAL_MINI_APP_SHORT_NAME=portal
ORIGINATION_MINI_APP_SHORT_NAME=origination
FARMUP_MINI_APP_SHORT_NAME=farmup
SYSUP_PROCESSING_CHUNK_SIZE=400
SYSUP_COMMIT_MAX_ROWS_PER_REQUEST=20
FCAUP_MINI_APP_SHORT_NAME=fcaup

# Google integrations
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_MEDIA_FOLDER_ID=replace-with-restricted-drive-folder-id

# TAT credit assessment. Setting the personal Gmail mailbox enables polling.
# OAuth JSON is the authorized-user secret produced after that Gmail account
# grants gmail.readonly consent. Drive still uses the existing service account.
CREDIT_ASSESSMENT_GMAIL_ENABLED=False
CREDIT_ASSESSMENT_GMAIL_USER=statement@example.com
CREDIT_ASSESSMENT_GMAIL_OAUTH_JSON={"client_id":"...apps.googleusercontent.com","client_secret":"...","refresh_token":"..."}
# Turn on only after the TAT credit-assessment migration, Gmail OAuth, Drive,
# roles, and product-stage configuration have passed readiness checks.
SPIN_HARD_CUTOVER=False

# JBL Visit: supporting-photo count (the four document captures are separate).
PORTAL_JBL_VISIT_MAX_FILES=6
PORTAL_JBL_VISIT_MAX_TOTAL_UPLOAD_MB=40
MEDIA_MAX_FILE_SIZE_MB=20

# Protected manual endpoints and release evidence
API_AUTH_TOKEN=replace-with-random-api-token
RELEASE_BACKUP_REFERENCE=replace-with-provider-backup-reference
RELEASE_ACTOR=deployment
RELEASE_ENVIRONMENT=production
REQUIRE_MINIAPP_IDEMPOTENCY_KEY=True

# Optional monitoring
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_ENVIRONMENT=production

# Bootstrap only. Remove these three after the first successful Admin login.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.invalid
DJANGO_SUPERUSER_PASSWORD=replace-with-a-unique-temporary-password

# Feature flags, provider credentials, limits, and tuning live in
# .env.optional.example. Copy only settings that intentionally override defaults.
