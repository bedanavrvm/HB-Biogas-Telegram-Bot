# Django Settings
# Use a unique secret manager value in Render. Never reuse this placeholder.
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ORIGINATION_TEST_SIGNING_ENABLED=False
ORIGINATION_ESIGN_ENABLED=False
AFRICASTALKING_SMS_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africas-talking-sandbox-api-key
AFRICASTALKING_SENDER_ID=
ORIGINATION_SIGNING_LINK_TTL_HOURS=48
# Optional HTTPS origin for shorter signer links; blank uses APP_BASE_URL.
ORIGINATION_SIGNING_BASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com
DATABASE_CONN_MAX_AGE=600

# HTTPS and cookie protection. Keep these enabled in production.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database (PostgreSQL is required in production; SQLite is local development only.)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local only: DATABASE_URL=sqlite:///db.sqlite3

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_BOT_DISPLAY_NAME=Telegram Bot
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here
APP_DISPLAY_NAME=Telegram Workflow Bot

# Manual API protection
API_AUTH_TOKEN=your-manual-api-token-here

# Django Superuser (for deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# Google service account
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/credentials.json

# Public app URL used to build Telegram Mini App / fallback links.
# Must be HTTPS and must not end with a slash.
APP_BASE_URL=https://your-app-name.onrender.com
APP_RELEASE=git-commit-or-render-deploy-id

# Required for a production release. Create the Sentry Django project first,
# then store its DSN only in Render's secret environment configuration.
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Separate public DSN for the Sentry Browser project. The browser SDK is
# disabled when this is blank; Session Replay is never enabled.
SENTRY_BROWSER_DSN=
SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.05
MINIAPP_DIAGNOSTICS_ENABLED=true
MINIAPP_DIAGNOSTICS_HEARTBEAT_SECONDS=60
MINIAPP_DIAGNOSTICS_RAW_RETENTION_DAYS=14
MINIAPP_DIAGNOSTICS_AGGREGATE_RETENTION_DAYS=180
MINIAPP_DIAGNOSTICS_TOKEN_MAX_AGE_SECONDS=172800
MINIAPP_DIAGNOSTICS_MAX_PAYLOAD_BYTES=8192

# Global workflow branches
# Used by Order Approval, SPIN/CRB, TAT Tracker, and other branch-aware workflows unless a workflow-specific override is set.
WORKFLOW_BRANCH_CHOICES=Corporate,East Nairobi,West Nairobi,Thika Road,Limuru,Embu,Nakuru,Biogas Unit,Eco Conserve
# Optional per-workflow overrides. Leave blank/commented to use WORKFLOW_BRANCH_CHOICES.
# ORDER_APPROVAL_BRANCH_CHOICES=Corporate,East Nairobi,West Nairobi,Thika Road,Limuru,Embu,Nakuru,Biogas Unit,Eco Conserve
# TAT_TRACKER_BRANCH_CHOICES=Corporate,East Nairobi,West Nairobi,Thika Road,Limuru,Embu,Nakuru,Biogas Unit,Eco Conserve

# Google Drive media storage
# Use a Shared Drive folder or a folder owned by an account with quota.
MEDIA_STORAGE_PROVIDER=google_drive
MEDIA_MAX_FILE_SIZE_MB=20
PORTAL_JBL_VISIT_MAX_FILES=6
PORTAL_JBL_VISIT_MAX_TOTAL_UPLOAD_MB=40
ORIGINATION_EVIDENCE_MAX_FILE_SIZE_MB=10
ORIGINATION_EVIDENCE_MAX_FILES_PER_REQUIREMENT=5
ORIGINATION_EVIDENCE_MAX_TOTAL_UPLOAD_MB=30
FILE_UPLOAD_MAX_MEMORY_SIZE=0
GOOGLE_DRIVE_MEDIA_FOLDER_ID=your-shared-drive-folder-id

# Order Approval Mini App and uploads
ORDER_APPROVAL_WEBAPP_ENABLED=True
ORDER_APPROVAL_MINI_APP_SHORT_NAME=orderapproval
ORDER_APPROVAL_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
ORDER_APPROVAL_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
ORDER_APPROVAL_MAX_FILES_PER_SLOT=10
ORDER_APPROVAL_MAX_TOTAL_UPLOAD_MB=60
ORDER_APPROVAL_IMAGE_PREVIEWS_ENABLED=False
ORDER_APPROVAL_IMAGE_PREVIEW_LIMIT=3

# Jawabu / Farmers / FCA review Mini Apps
FARMUP_MINI_APP_SHORT_NAME=farmup
FCAUP_MINI_APP_SHORT_NAME=fcaup
FCA_BATCH_MAX_FILE_SIZE_MB=10
# `/sysup` is deliberately bounded on free Render. Split exports above the
# row cap; the review screen commits approved rows in safe chunks.
SYSUP_MAX_FILE_SIZE_MB=5
SYSUP_MAX_ROWS_PER_UPLOAD=150
SYSUP_COMMIT_MAX_ROWS_PER_REQUEST=20

# Portal Mini App
PORTAL_MINI_APP_SHORT_NAME=portal
ORIGINATION_MINI_APP_SHORT_NAME=origination
ORIGINATION_TEMPLATE_MAX_FILE_SIZE_MB=15
# Testing-only Django Admin clean-slate reset. Never enable routinely in production.
ORIGINATION_FULL_RESET_ENABLED=False
INVOICE_NAME_CHANGE_TEMPLATE_MAX_FILE_SIZE_MB=10
PORTAL_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
PORTAL_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Cost-free Portal dictation pilot. Keep disabled until the Groq project has
# Zero Data Retention enabled and the vendor/privacy approval is recorded.
PORTAL_VOICE_INPUT_ENABLED=False
PORTAL_VOICE_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
PORTAL_VOICE_MODEL=whisper-large-v3
PORTAL_VOICE_MAX_SECONDS=30
PORTAL_VOICE_DAILY_REQUEST_LIMIT=1000
PORTAL_VOICE_DAILY_AUDIO_SECONDS=14400
PORTAL_VOICE_USER_DAILY_REQUEST_LIMIT=60
PORTAL_VOICE_RETRY_RETENTION_MINUTES=60

# Complaint Cases Mini App and field evidence uploads
COMPLAINT_CASES_MINI_APP_SHORT_NAME=complaints
COMPLAINT_CASES_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
COMPLAINT_CASES_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
COMPLAINT_CASE_MAX_FILES_PER_UPDATE=10
COMPLAINT_CASE_MAX_FILE_SIZE_MB=10
COMPLAINT_CASE_MAX_TOTAL_UPLOAD_MB=30

# SPIN / CRB Mini App and uploads
SPIN_MINI_APP_SHORT_NAME=spin
SPIN_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
SPIN_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
SPIN_MAX_FILES_PER_SLOT=2
SPIN_MAX_TOTAL_UPLOAD_MB=20

# TAT Tracker Mini App
TAT_TRACKER_MINI_APP_SHORT_NAME=tattracker
TAT_TRACKER_WEBAPP_REQUIRE_TELEGRAM_AUTH=True
TAT_TRACKER_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
TAT_TRACKER_SYNC_SECONDARY_SHEETS=False
# Base seconds for bounded Google Sheets quota backoff during Admin repair/retry jobs.
TAT_REPAIR_RETRY_BASE_SECONDS=2
# Delay between case writes so a large repair stays below Google Sheets write quotas.
TAT_REPAIR_CASE_DELAY_SECONDS=1.1
# Keep disabled until the e-signature integration is fully deployed and verified.
TAT_TRACKER_SIGNATURES_ENABLED=False

# Processing
DEDUPLICATION_WINDOW_MINUTES=5
BATCH_PROCESSING_DELAY=1
WHATSAPP_BATCH_MAX_MESSAGES=0
WHATSAPP_BATCH_ASYNC_THRESHOLD=100
WHATSAPP_BATCH_MAX_FILE_SIZE_MB=5
INVOICE_UPLOAD_MAX_FILE_SIZE_MB=8
# Maximum size of one physically signed/stamped requisition or payment scan.
DOCUMENT_SIGNOFF_MAX_FILE_SIZE_MB=12

# Compliance audit: checkpoints are local/read-only evidence by default.
# Enable delivery only after an approved controlled compliance mailbox exists.
COMPLIANCE_AUDIT_CHECKPOINT_DELIVERY_ENABLED=False
COMPLIANCE_AUDIT_CHECKPOINT_RECIPIENT=

# Mini App idempotency: keep false until refreshed cached Telegram clients are verified.
REQUIRE_MINIAPP_IDEMPOTENCY_KEY=False
# Bounded synchronous retry for Google Sheets writes; no worker/scheduler is enabled.
GOOGLE_SHEETS_MAX_RETRIES=4

# Group to spreadsheet/workflow routing is configured in Django admin:
# Core -> Group sheet configurations.
# Prefer admin configuration over env JSON for all current workflows.
# Legacy single-group/env JSON values are supported only for old deployments.
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB_NAME=Complaints Register
# DEFAULT_GROUP_ID=default
# GROUP_MAPPING_JSON={}
# WORKFLOW_CONFIG_JSON={}
# SHEET_SCHEMA_JSON={}
# PARSER_RULES_JSON={}

# API Rate Limiting (optional)
RATELIMIT_ENABLE=False
RATELIMIT_PER_IP=100/h
